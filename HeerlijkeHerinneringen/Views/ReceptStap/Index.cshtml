@model IEnumerable<HeerlijkeHerinneringen.Libraries.ViewModels.ReceptStapViewModel>
@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

@* <p>
    <a asp-action="Create">Create New</a>
</p> *@
<table class="table">
    <thead>
        <tr>
            <th>Stap</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.Volgorde)</td>
                <td>@Html.DisplayFor(modelItem => item.Beschrijving)</td>

                <td>
                    @Html.ActionLink("Edit", "Edit", new { id = item.Id }) |
                     @Html.ActionLink("Details", "Details", new { id = item.Id }) |
                   @*  @Html.ActionLink("Delete", "Delete", new { id = item.Id }) *@
                </td>
            </tr>
        }
    </tbody>
</table>