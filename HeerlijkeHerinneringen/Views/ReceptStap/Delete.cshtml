@model HeerlijkeHerinneringen.Libraries.ViewModels.ReceptStapViewModel
@{
    ViewData["Title"] = "Delete";
}

<h1>Delete</h1>

<h3>Weet je zeker dat je deze stap niet meer nodig hebt?</h3>

<div>
    <h4>Stap</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            Ingredient die je wilt verwijderen:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Volgorde)
        </dd>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Beschrijving)
        </dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-action="Index" class="btn btn-secondary">Terug naar lijst</a>
    </form>
</div>